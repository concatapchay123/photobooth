VITE_PHOTOBOOTH_ADMIN_PIN=2468

# Set these only on the home server after setting up a stable HTTPS domain.
# Keep the rental admin token secret; it is a server-side value, not a VITE_ value.
# PHOTOBOOTH_RENTAL_MODE=true
# PHOTOBOOTH_RENTAL_ADMIN_TOKEN=replace-with-a-long-random-secret
# Keep browser AI disabled for rental hosting by default. VITE_ API keys are visible
# to anyone who can open the kiosk page. Enable only with a limited-use key.
# PHOTOBOOTH_ALLOW_BROWSER_AI=false

# DSLR (digiCamControl) integration flag. 
# Set to 'true' on the production kiosk laptop with DSLR cabled.
# Set to 'false' (default) on development laptop for testing with local webcam only.
VITE_DSLR_MODE=false

# Optional: exact Windows printer name for silent printing.
# PRINTER_NAME=
