                <div 
                  className="bg-gradient-to-r from-[#f73591] to-[#ff7eb3] h-1.5 rounded-full transition-all duration-300"
                  style={{ 
                    width: `${
                      (guestRenderProgress.image === 'done' ? 25 : 0) +
                      (guestRenderProgress.print === 'done' || guestRenderProgress.print === 'failed' || guestRenderProgress.print === 'skipped' ? 25 : 0) +
                      (guestRenderProgress.video === 'done' || guestRenderProgress.video === 'skipped' ? 25 : 0) +
                      (guestRenderProgress.upload === 'done' ? 25 : 0)
                    }%` 
                  }}
                />
              </div>

              <p className="text-[10px] font-bold text-[#7a4962]/50 italic">Vui lòng không tắt hoặc tải lại trang</p>
            </div>
