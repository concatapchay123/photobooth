              <div>
                <h2 className="text-2xl font-black text-[#74194a] tracking-tight">Đang chuẩn bị thành quả...</h2>
                <p className="text-xs font-semibold text-[#7a4962]/80 mt-1 leading-relaxed">
                  Hệ thống đang xử lý ảnh chụp và dựng video chất lượng cao cho bạn.
                </p>
              </div>

              {/* Progress indicators */}
              <div className="w-full flex flex-col gap-3.5 text-left bg-[#fff7fb] border border-[#ffebf4]/60 p-5 rounded-2xl">
                {/* Step 1: Render printable sheet */}
                <div className="flex items-center justify-between">
                  <div className="flex items-center gap-3">
                    <div className="shrink-0 flex items-center justify-center">
                      {guestRenderProgress.image === 'running' && <Loader2 className="size-5 text-[#f73591] animate-spin" />}
                      {guestRenderProgress.image === 'done' && <CheckCircle2 className="size-5 text-emerald-500 shrink-0" />}
                      {guestRenderProgress.image === 'pending' && <Circle className="size-5 text-slate-300" />}
                    </div>
                    <span className={`text-sm font-bold ${guestRenderProgress.image === 'running' ? 'text-[#f73591]' : guestRenderProgress.image === 'done' ? 'text-[#74194a]' : 'text-slate-400'}`}>
                      Thiết kế bản in 10x15
                    </span>
                  </div>
                  {guestRenderProgress.image === 'running' && <span className="text-xs font-black text-[#f73591]/80 animate-pulse">Đang ghép...</span>}
                  {guestRenderProgress.image === 'done' && <span className="text-xs font-black text-emerald-500">Hoàn thành</span>}
                </div>

                {/* Step 2: Send print job */}
                {guestRenderProgress.print !== 'skipped' && (
                  <div className="flex items-center justify-between border-t border-pink-50/50 pt-3">
                    <div className="flex items-center gap-3">
                      <div className="shrink-0 flex items-center justify-center">
                        {guestRenderProgress.print === 'running' && <Loader2 className="size-5 text-[#f73591] animate-spin" />}
                        {guestRenderProgress.print === 'done' && <CheckCircle2 className="size-5 text-emerald-500 shrink-0" />}
                        {guestRenderProgress.print === 'failed' && <XCircle className="size-5 text-rose-500 shrink-0" />}
                        {guestRenderProgress.print === 'pending' && <Circle className="size-5 text-slate-300" />}
                      </div>
                      <span className={`text-sm font-bold ${guestRenderProgress.print === 'running' ? 'text-[#f73591]' : guestRenderProgress.print === 'done' ? 'text-[#74194a]' : 'text-slate-400'}`}>
                        Gửi lệnh in tự động
                      </span>
                    </div>
                    {guestRenderProgress.print === 'running' && <span className="text-xs font-black text-[#f73591]/80 animate-pulse">Đang gửi...</span>}
                    {guestRenderProgress.print === 'done' && <span className="text-xs font-black text-emerald-500">Đã gửi máy in</span>}
                    {guestRenderProgress.print === 'failed' && <span className="text-xs font-black text-rose-500">In thủ công sau</span>}
                  </div>
                )}

                {/* Step 3: Render videos */}
                {guestRenderProgress.video !== 'skipped' && (
                  <div className="flex items-center justify-between border-t border-pink-50/50 pt-3">
                    <div className="flex items-center gap-3">
                      <div className="shrink-0 flex items-center justify-center">
                        {guestRenderProgress.video === 'running' && <Loader2 className="size-5 text-[#f73591] animate-spin" />}
                        {guestRenderProgress.video === 'done' && <CheckCircle2 className="size-5 text-emerald-500 shrink-0" />}
                        {guestRenderProgress.video === 'pending' && <Circle className="size-5 text-slate-300" />}
                      </div>
                      <span className={`text-sm font-bold ${guestRenderProgress.video === 'running' ? 'text-[#f73591]' : guestRenderProgress.video === 'done' ? 'text-[#74194a]' : 'text-slate-400'}`}>
                        Dựng video hiệu ứng {guestRenderProgress.videoProgress && `(${guestRenderProgress.videoProgress})`}
                      </span>
                    </div>
                    {guestRenderProgress.video === 'running' && <span className="text-xs font-black text-[#f73591]/80 animate-pulse">Đang render...</span>}
                    {guestRenderProgress.video === 'done' && <span className="text-xs font-black text-emerald-500">Hoàn thành</span>}
                  </div>
                )}

                {/* Step 4: Upload and QR */}
                <div className="flex items-center justify-between border-t border-pink-50/50 pt-3">
                  <div className="flex items-center gap-3">
                    <div className="shrink-0 flex items-center justify-center">
                      {guestRenderProgress.upload === 'running' && <Loader2 className="size-5 text-[#f73591] animate-spin" />}
                      {guestRenderProgress.upload === 'done' && <CheckCircle2 className="size-5 text-emerald-500 shrink-0" />}
                      {guestRenderProgress.upload === 'pending' && <Circle className="size-5 text-slate-300" />}
                    </div>
                    <span className={`text-sm font-bold ${guestRenderProgress.upload === 'running' ? 'text-[#f73591]' : guestRenderProgress.upload === 'done' ? 'text-[#74194a]' : 'text-slate-400'}`}>
                      Tải lên & Tạo mã QR
                    </span>
                  </div>
                  {guestRenderProgress.upload === 'running' && <span className="text-xs font-black text-[#f73591]/80 animate-pulse">Đang tải...</span>}
                  {guestRenderProgress.upload === 'done' && <span className="text-xs font-black text-emerald-500">Đã tạo mã QR</span>}
                </div>
              </div>

