function showToast(message) {
  let container = document.getElementById('toast-container');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toast-container';
    container.style.cssText = `
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      z-index: 9999;
      pointer-events: none;
    `;
    document.body.appendChild(container);
  }

  const toast = document.createElement('div');
  toast.className = 'glass-panel';
  toast.style.cssText = `
    padding: 0.8rem 1.8rem;
    border-radius: var(--radius-lg);
    background: rgba(10, 14, 26, 0.95);
    border: 1px solid var(--accent-neon-blue);
    color: #fff;
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: 0 5px 15px rgba(0, 240, 255, 0.25);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    animation: zoomIn 0.25s forwards, fadeOut 0.5s 2.5s forwards;
  `;

  if (!document.getElementById('toast-keyframes')) {
    const style = document.createElement('style');
    style.id = 'toast-keyframes';
    style.textContent = `
      @keyframes fadeOut {
        to { opacity: 0; transform: translateY(10px); }
      }
    `;
    document.head.appendChild(style);
  }

  toast.innerHTML = `<i class="fa-solid fa-circle-check" style="color: var(--accent-neon-blue)"></i> ${message}`;
  container.appendChild(toast);

  setTimeout(() => {
    toast.remove();
  }, 3000);
}

