  scene.add(particleSystem);

  // 7. Place 58 Physical 3D Frame Boards in 1 row of 58 columns
  let frameCounter = 0;

  for (let col = 0; col < totalCols; col++) {
    if (frameCounter >= state.frames.length) break;

    const frame = state.frames[frameCounter];
    const idx = frameCounter;
    frameCounter++;

    // Math coordinates: X spreads horizontally, Y represents vertical center, Z is flat
    const X_pos = minColX + col * spacingX;
    const Y_pos = 0;
    const Z_pos = 0;

    // Board Dimensions - Increased height by 50% from 2.15 to 3.225
    const boardHeight = 3.225; 
    const boardWidth = boardHeight * (frame.width / frame.height);

    // Create Group container for the board (flat facing viewer)
    const boardGroup = new THREE.Group();
    boardGroup.position.set(X_pos, Y_pos, Z_pos);

    // Tilt group (kept at 0 rotation for flat alignment)
    const tiltGroup = new THREE.Group();
    boardGroup.add(tiltGroup);

    // Generate offscreen pre-fitted canvas and map to texture
    const textureHeight = 1600; // Increased from 512 for high clarity and sharpness when zoomed in
    const textureWidth = Math.round(textureHeight * (frame.width / frame.height));
    const frameCanvas = getFrameCanvas(frame, textureWidth, textureHeight);
    const artworkTex = new THREE.CanvasTexture(frameCanvas);
    artworkTex.anisotropy = renderer.capabilities.getMaxAnisotropy();

    // 1. Inner Artwork Plane (MeshBasicMaterial preserves perfect contrast and original customer colors)
    const artGeo = new THREE.PlaneGeometry(boardWidth, boardHeight);
    const artMat = new THREE.MeshBasicMaterial({
      map: artworkTex,
      color: 0xffffff, // Set to 100% full brightness to preserve exact source colors
      fog: false,      // Disable fog on artwork to ensure photo contrast and brightness are fully preserved
      transparent: true // Enable transparency so that the background and slots of the PNG frame remain transparent
    });
    const artMesh = new THREE.Mesh(artGeo, artMat);
    artMesh.position.set(0, 0, 0.005); // Float-mounted slightly in front of the wall
    tiltGroup.add(artMesh);

    // 2. Glossy Glass Overlay (realistic dielectric glass, soft highlights, subtle reflection)
    const glassGeo = new THREE.PlaneGeometry(boardWidth, boardHeight);
    const glassMat = new THREE.MeshStandardMaterial({
      color: 0xffffff,
      transparent: true,
      opacity: 0.015,       // Extremely subtle glass layer to prevent any glaring reflection
      roughness: 0.15,      // Softer, wider specular highlights
      metalness: 0.0        // Dielectric glass
    });
    const glassMesh = new THREE.Mesh(glassGeo, glassMat);
    glassMesh.position.set(0, 0, 0.008); // Slightly in front of artwork
    tiltGroup.add(glassMesh);

    // 3. Soft Drop Shadow cast on the wall/background behind the canvas
    const shadowGeo = new THREE.PlaneGeometry(boardWidth + 0.25, boardHeight + 0.25);
    const shadowMat = new THREE.MeshBasicMaterial({
      map: shadowTex,
      transparent: true,
      blending: THREE.NormalBlending, // Normal blending for dark shadows
      depthWrite: false,
      opacity: 0.65
    });
    const shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);
    // Shift slightly down and right to simulate light from top-left
    shadowMesh.position.set(0.05, -0.05, -0.005);
    tiltGroup.add(shadowMesh);

    // 4. Floating 3D Text Label above the frame
    const labelTex = createLabelTexture(frame.name);
    const labelGeo = new THREE.PlaneGeometry(1.33, 0.25);
    const labelMat = new THREE.MeshBasicMaterial({
      map: labelTex,
      transparent: true,
      fog: false // Keep text readable even with fog
    });
    const labelMesh = new THREE.Mesh(labelGeo, labelMat);
    // Position it slightly above the top of the frame
    labelMesh.position.set(0, boardHeight / 2 + 0.22, 0.01);
    tiltGroup.add(labelMesh);

    // Store references for animations and raycasting
    boardGroup.userData = {
      id: frame.id,
      index: idx,
      frame: frame,
      basePos: boardGroup.position.clone(),
      normalVec: new THREE.Vector3(0, 0, 1).normalize(), // Flat normal vector
      offset: 0,
      targetOffset: 0,
      col: col,
      row: 0,
      artMat: artMat,
      borderMat: null,    // No wood border material anymore
      glow: shadowMesh    // Map glow to shadowMesh for animation updates
    };

    // Set identification tag on artwork and glass for raycasting
    artMesh.userData = { parentGroup: boardGroup };
    glassMesh.userData = { parentGroup: boardGroup };

    scene.add(boardGroup);
    frameBoards.push(boardGroup);
  }


}

// --- Window Resize Handler ---
function onWindowResize() {
  const container = document.getElementById('gallery-3d-stage');
  if (!container || !camera || !renderer) return;

  camera.aspect = container.clientWidth / container.clientHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(container.clientWidth, container.clientHeight);
}

// --- Camera Focus Transition on Selected Frame ---
function focusCameraOnFrame(frame, boardX, boardY, boardZ, col, row) {
  state.focusedFrame = frame;

  // Turn off auto mode, toggle HUD panels
  setExhibitionViewMode('manual');
  resetIdleTimer();

  // Glide camera directly in front of the board
  const focusZ = 2.5; // Zoom close-up (zoomed in closer matching the new zoomed hallway)
  
  state.camera.targetX = boardX * 100;
  state.camera.targetY = -boardY * 100; // Match Y axis inversion
  state.camera.targetZ = focusZ * 100;
  state.camera.targetYaw = 0;           // Keep flat front-facing view
  state.camera.targetPitch = 0;         // Keep flat front-facing view

  // Slide down and show focused frame title badge
  const titleHud = document.getElementById('focused-frame-title-hud');
  const titleName = document.getElementById('focused-frame-name');
  if (titleHud && titleName) {
    titleName.textContent = frame.name;
    titleHud.style.transform = 'translateX(-50%) translateY(0)';
    titleHud.style.opacity = '1';
  }
}

// --- Reset Camera Focus back to Slider hallway ---
function resetCameraFocus() {
  state.focusedFrame = null;

  // Return camera back to default hallway distance, keep current scroll position X
  state.camera.targetZ = 330;
  state.camera.targetY = 0;
  state.camera.targetYaw = 0;
  state.camera.targetPitch = 0;

  // Slide up and hide focused frame title badge
  const titleHud = document.getElementById('focused-frame-title-hud');
  if (titleHud) {
    titleHud.style.transform = 'translateX(-50%) translateY(-100px)';
    titleHud.style.opacity = '0';
  }
}

// --- 3D Exhibition Game Loop (called 60fps) ---
function exhibitionLoop(timestamp) {
  // 1. Process Auto Tour movement (Slide camera X horizontally)
  if (state.viewMode === 'auto' && state.autoTour.active) {
    // Increment X coordinate smoothly
    const scrollStep = 1.3 * state.autoTour.speed * state.autoTour.direction;
    state.camera.targetX += scrollStep;

    // Lock orientation and Y height during auto-scroll
    state.camera.targetY = 0;
    state.camera.targetZ = 330;
    state.camera.targetYaw = 0;
    state.camera.targetPitch = 0;
  }

  // 2. Camera coordinate LERP interpolation for smooth movements
  state.camera.x += (state.camera.targetX - state.camera.x) * 0.07;
  state.camera.y += (state.camera.targetY - state.camera.y) * 0.07;
  state.camera.z += (state.camera.targetZ - state.camera.z) * 0.07;
  state.camera.yaw += (state.camera.targetYaw - state.camera.yaw) * 0.08;
  state.camera.pitch += (state.camera.targetPitch - state.camera.pitch) * 0.08;

  // 3. Infinite loop wrap-around logic for camera position (6960 pixels loop width)
  if (state.camera.targetX > halfLoopWidthPixels) {
    state.camera.targetX -= loopWidthPixels;
    state.camera.x -= loopWidthPixels;
    if (state.dragging) {
      state.dragStartRot.x -= loopWidthPixels;
    }
  } else if (state.camera.targetX < -halfLoopWidthPixels) {
    state.camera.targetX += loopWidthPixels;
    state.camera.x += loopWidthPixels;
    if (state.dragging) {
      state.dragStartRot.x += loopWidthPixels;
    }
  }

  // 4. Render Camera view onto WebGL Scene
  if (camera && renderer && scene) {
    camera.position.set(state.camera.x / 100, -state.camera.y / 100, state.camera.z / 100);
    const radYaw = (state.camera.yaw * Math.PI) / 180;
    const radPitch = (-state.camera.pitch * Math.PI) / 180;
    camera.rotation.set(radPitch, radYaw, 0, 'YXZ');

    // Volumetric dust particle drift -> Warm fireflies drifting gently
    if (particleSystem) {
      const positions = particleSystem.geometry.attributes.position.array;
      const time = timestamp * 0.001;
      for (let i = 0; i < positions.length; i += 3) {
        // Drift horizontally
        positions[i] += Math.sin(time * 0.5 + i) * 0.002;
        // Drift vertically (upwards slowly)
        positions[i + 1] += 0.003 + Math.cos(time * 0.3 + i) * 0.0015;
        // If it goes above the screen, loop back to the bottom
        if (positions[i + 1] > 4.5) {
          positions[i + 1] = -4.5;
          positions[i] = (Math.random() - 0.5) * 80; // randomize X slightly to prevent repeating paths
        }
        // Drift depth
        positions[i + 2] += Math.sin(time * 0.2 + i) * 0.001;
      }
      particleSystem.geometry.attributes.position.needsUpdate = true;
    }

    // Dynamic repositioning and LERP offsets for infinite loop wrap-around
    const camX_units = camera.position.x;
    frameBoards.forEach(board => {
      const data = board.userData;
      data.offset += (data.targetOffset - data.offset) * 0.15;

      // Calculate relative distance wrapped to [-halfLoopWidth, halfLoopWidth]
      let diffX = data.basePos.x - camX_units;
      diffX = ((diffX + halfLoopWidth) % loopWidth + loopWidth) % loopWidth - halfLoopWidth;

      // Update position dynamically
      board.position.set(
        camX_units + diffX + data.normalVec.x * data.offset,
        data.basePos.y + data.normalVec.y * data.offset,
        data.basePos.z + data.normalVec.z * data.offset
      );

      // Color/Glow adjustments based on targetOffset or Focus state
      const isFocused = state.focusedFrame && state.focusedFrame.id === data.id;
      
      if (data.targetOffset > 0) {
        // Hover Highlight (100% full brightness, deeper shadow)
        data.artMat.color.setHex(0xffffff); 
        if (data.borderMat) {
          data.borderMat.color.setHex(0x3a312a);
          data.borderMat.emissive.setHex(0x000000);
          data.borderMat.emissiveIntensity = 0;
        }
        if (data.glow) data.glow.material.opacity = 0.85; // Stronger drop shadow
      } else if (isFocused) {
        // Focused Clicked State (100% full brightness, deeper shadow)
        data.artMat.color.setHex(0xffffff); 
        if (data.borderMat) {
          data.borderMat.color.setHex(0x3a312a);
          data.borderMat.emissive.setHex(0x000000);
          data.borderMat.emissiveIntensity = 0;
        }
        if (data.glow) data.glow.material.opacity = 0.90; // Deepest drop shadow
      } else {
        // Normal State (100% full brightness, preserving exact source colors)
        data.artMat.color.setHex(0xffffff); 
        if (data.borderMat) {
          data.borderMat.color.setHex(0x241c15);
          data.borderMat.emissive.setHex(0x000000);
          data.borderMat.emissiveIntensity = 0;
        }
        if (data.glow) data.glow.material.opacity = 0.65; // Soft ambient drop shadow
      }
    });

    // Render WebGL
    renderer.render(scene, camera);
  }

  // 5. Update HUD progress statistics
  const progressPercent = ((state.camera.x + halfLoopWidthPixels) / loopWidthPixels) * 100;
  
  const fillBar = document.getElementById('tour-progress-bar-fill');
  if (fillBar) fillBar.style.width = `${progressPercent}%`;

  const posText = document.getElementById('stats-camera-z');
  if (posText) {
    const currentCol = Math.round((state.camera.x + halfLoopWidthPixels) / (spacingX * 100)) + 1;
    posText.textContent = `Col ${Math.max(1, Math.min(totalCols, currentCol))}/${totalCols}`;
  }

  // Request next frame
  requestAnimationFrame(exhibitionLoop);
}

// --- Idle Timer & Auto/Manual Mode Transition ---
let idleTimer = null;

function resetIdleTimer() {
  if (idleTimer) {
    clearTimeout(idleTimer);
  }
  if (state.viewMode === 'auto') {
    setExhibitionViewMode('manual');
  }
  idleTimer = setTimeout(() => {
    setExhibitionViewMode('auto');
  }, 7000);
}

// --- Toggle Exhibition View Mode ---
function setExhibitionViewMode(mode) {
  state.viewMode = mode;
  
  if (mode === 'auto' && idleTimer) {
    clearTimeout(idleTimer);
    idleTimer = null;
  }
  
  const autoBtn = document.getElementById('mode-auto-btn');
  const manualBtn = document.getElementById('mode-manual-btn');
  const navControls = document.getElementById('hud-nav-controls');
  const tourSettings = document.getElementById('hud-tour-settings');
  const stage = document.getElementById('gallery-3d-stage');

  if (mode === 'auto') {
    autoBtn.classList.add('active');
    manualBtn.classList.remove('active');
    navControls.classList.add('disabled');
    tourSettings.classList.remove('disabled');
    stage.classList.remove('manual-explore-mode');
    
    state.autoTour.active = true;
    
    // Clear focus when returning to auto-scroll
    if (state.focusedFrame) {
      resetCameraFocus();
    }
  } else {
    autoBtn.classList.remove('active');
    manualBtn.classList.add('active');
    navControls.classList.remove('disabled');
    tourSettings.classList.add('disabled');
    stage.classList.add('manual-explore-mode');
    
    state.autoTour.active = false;
    
    // Keep camera targets static when pausing
    state.camera.targetX = state.camera.x;
    state.camera.targetY = state.camera.y;
    state.camera.targetZ = state.camera.z;
    state.camera.targetYaw = 0;
    state.camera.targetPitch = 0;
  }

  // Update status labels
  const statusLabel = document.getElementById('tour-status-text');
  if (statusLabel) {
    const dict = translations[state.lang];
    if (mode === 'auto') {
      statusLabel.innerHTML = `<span class="pulse-dot"></span> ${dict.tourStatusAuto}`;
    } else {
      statusLabel.innerHTML = `<i class="fa-solid fa-circle-pause" style="color: var(--text-muted)"></i> ${dict.tourStatusManual}`;
    }
  }
}

// --- Handle Keyboard walking controls (Manual Mode) ---
function setupKeyboardControls() {
  const stepX = 150; // Horizontal scroll delta per keypress
  const stepZ = 40;  // Zoom depth delta per keypress

  window.addEventListener('keydown', (e) => {
    const key = e.key.toLowerCase();
    const isMovementKey = ['a', 'd', 'w', 's', 'arrowleft', 'arrowright', 'arrowup', 'arrowdown', ' ', 'spacebar'].includes(key);
    if (isMovementKey) {
      resetIdleTimer();
    }

    if (state.viewMode !== 'manual') return;
    
    // Scroll Left
    if (key === 'a' || e.key === 'ArrowLeft') {
      e.preventDefault();
      state.camera.targetX -= stepX;
    }
    // Scroll Right
    if (key === 'd' || e.key === 'ArrowRight') {
      e.preventDefault();
      state.camera.targetX += stepX;
    }

    // Zoom In
    if (key === 'w' || e.key === 'ArrowUp') {
      e.preventDefault();
      state.camera.targetZ -= stepZ;
      state.camera.targetZ = Math.max(180, state.camera.targetZ); // prevent clipping
    }
    // Zoom Out
    if (key === 's' || e.key === 'ArrowDown') {
      e.preventDefault();
      state.camera.targetZ += stepZ;
      state.camera.targetZ = Math.min(800, state.camera.targetZ);
    }

    // Reset view look vector straight ahead at center
    if (e.key === ' ' || key === 'spacebar') {
      e.preventDefault();
      state.camera.targetX = 0;
      state.camera.targetY = 0;
      state.camera.targetZ = 330;
      state.camera.targetYaw = 0;
      state.camera.targetPitch = 0;
      if (state.focusedFrame) {
        resetCameraFocus();
      }
    }
  });
}

