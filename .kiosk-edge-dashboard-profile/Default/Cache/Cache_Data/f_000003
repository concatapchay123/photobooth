    updateLanguageDOM();
  });

  // Help buttons
  document.getElementById('help-btn').addEventListener('click', openHelpModal);
  document.getElementById('close-modal-btn').addEventListener('click', closeHelpModal);
  document.getElementById('close-modal-ok').addEventListener('click', closeHelpModal);
  document.getElementById('help-modal').addEventListener('click', (e) => {
    if (e.target.id === 'help-modal') closeHelpModal();
  });

  // Speed adjustments
  const speedSlider = document.getElementById('tour-speed-slider');
  speedSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    state.autoTour.speed = val;
    document.getElementById('tour-speed-value').textContent = `${val.toFixed(1)}x`;
  });

  // Progress bar navigation click
  document.getElementById('tour-progress-bar-container').addEventListener('click', (e) => {
    resetIdleTimer();
    const rect = e.currentTarget.getBoundingClientRect();
    const percent = (e.clientX - rect.left) / rect.width;
    
    // Jump camera targetX matching percent clicked
    const targetX = -halfLoopWidthPixels + percent * loopWidthPixels;
    state.camera.targetX = targetX;
    
    if (state.focusedFrame) {
      resetCameraFocus();
    }
  });

  // Walkway DPad buttons
  document.getElementById('nav-forward').addEventListener('click', () => {
    resetIdleTimer();
    // Zoom In
    state.camera.targetZ -= 80;
    state.camera.targetZ = Math.max(180, state.camera.targetZ);
  });
  document.getElementById('nav-backward').addEventListener('click', () => {
    resetIdleTimer();
    // Zoom Out
    state.camera.targetZ += 80;
    state.camera.targetZ = Math.min(800, state.camera.targetZ);
  });
  document.getElementById('nav-left').addEventListener('click', () => {
    resetIdleTimer();
    // Scroll Left
    state.camera.targetX -= 240;
  });
  document.getElementById('nav-right').addEventListener('click', () => {
    resetIdleTimer();
    // Scroll Right
    state.camera.targetX += 240;
  });
  document.getElementById('nav-reset').addEventListener('click', () => {
    resetIdleTimer();
    // Reset to center of gallery
    state.camera.targetX = 0;
    state.camera.targetY = 0;
    state.camera.targetZ = 330;
    state.camera.targetYaw = 0;
    state.camera.targetPitch = 0;
    if (state.focusedFrame) {
      resetCameraFocus();
    }
  });

  // Details card buttons removed per user request

  // Drag to scroll horizontally (Manual mode)
  const stage = document.getElementById('gallery-3d-stage');
  
  stage.addEventListener('pointerdown', (e) => {
    pointerDownPos.x = e.clientX;
    pointerDownPos.y = e.clientY;

    resetIdleTimer();

    if (state.viewMode !== 'manual') return;
    
    state.dragging = true;
    state.dragStart.x = e.clientX;
    state.dragStart.y = e.clientY;
    state.dragStartRot.x = state.camera.x;
    state.dragStartRot.y = state.camera.y;
    
    stage.setPointerCapture(e.pointerId);
  });

  stage.addEventListener('pointermove', (e) => {
    const container = document.getElementById('gallery-3d-stage');
    
    const rect = container.getBoundingClientRect();
    mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

    // Raycast hover highlight
    if (renderer && camera && scene) {
      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObjects(scene.children, true);
      
      let foundBoard = null;
      let isOverInteractable = false;

      if (intersects.length > 0) {
        for (let hit of intersects) {
          if (hit.object.userData && hit.object.userData.parentGroup) {
            foundBoard = hit.object.userData.parentGroup;
            isOverInteractable = true;
            break;
          }
        }
      }

      if (foundBoard !== hoveredBoard) {
        if (hoveredBoard) {
          hoveredBoard.userData.targetOffset = 0; // Reset
        }
        hoveredBoard = foundBoard;
        if (hoveredBoard) {
          hoveredBoard.userData.targetOffset = 0.22; // Pop out
        }
      }

      if (isOverInteractable) {
        container.style.cursor = 'pointer';
      } else {
        container.style.cursor = state.viewMode === 'manual' ? (state.dragging ? 'grabbing' : 'grab') : 'default';
      }
    }

    if (!state.dragging) return;

    resetIdleTimer();
    
    const deltaX = e.clientX - state.dragStart.x;
    const deltaY = e.clientY - state.dragStart.y;
    
    // Dragging left scrolls the gallery right (camera targetX shifts positive)
    state.camera.targetX = state.dragStartRot.x - deltaX * 3.5;
    
    // Dragging up/down shifts Y height slightly for viewing lower/upper rows
    state.camera.targetY = state.dragStartRot.y + deltaY * 1.5;
    state.camera.targetY = Math.max(-100, Math.min(100, state.camera.targetY));
  });

  const handleDragUp = (e) => {
    if (state.dragging) {
      state.dragging = false;
      try {
        stage.releasePointerCapture(e.pointerId);
      } catch (err) {}
      resetIdleTimer();
    }

    // Check if simple click (distance moved is very small)
    const dist = Math.hypot(e.clientX - pointerDownPos.x, e.clientY - pointerDownPos.y);
    if (dist < 4) {
      handleWebGLClick(e);
    }
  };

  stage.addEventListener('pointerup', handleDragUp);
  stage.addEventListener('pointercancel', handleDragUp);

  // Mouse wheel scroll to slide horizontally
  stage.addEventListener('wheel', (e) => {
    resetIdleTimer();
    if (state.viewMode !== 'manual') return;
    e.preventDefault();
    
    // Wheel scrolls camera X horizontally (unbounded, wrapped in render loop)
    state.camera.targetX += e.deltaY * 1.8;
  }, { passive: false });
}

// --- Raycaster Mouse Clicks handler ---
function handleWebGLClick(e) {
  if (!renderer || !camera || !scene) return;

  const container = document.getElementById('gallery-3d-stage');
  const rect = container.getBoundingClientRect();
  mouse.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  mouse.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;

  raycaster.setFromCamera(mouse, camera);
  const intersects = raycaster.intersectObjects(scene.children, true);

  if (intersects.length > 0) {
    for (let hit of intersects) {
      const obj = hit.object;
      
      // 1. Click Frame Board -> Zoom focus
      if (obj.userData && obj.userData.parentGroup) {
        const board = obj.userData.parentGroup;
        const data = board.userData;
        focusCameraOnFrame(data.frame, board.position.x, board.position.y, board.position.z, data.col, data.row);
        return;
      }
    }
  }

  // 3. Click background -> Reset camera focus
  if (state.focusedFrame) {
    resetCameraFocus();
    resetIdleTimer();
  }
}

