// --- Load Metadata and Pre-Fit All Frames ---
async function loadFramesDataAndGenerateFits() {
  try {
    const registryResponse = await fetch('./frames/registry.json');
    if (!registryResponse.ok) throw new Error('Cannot load registry.json');
    const registryData = await registryResponse.json();

    let analysisReport = null;
    try {
      const reportResponse = await fetch('./frames/slot-analysis-report.json');
      if (reportResponse.ok) {
        analysisReport = await reportResponse.json();
      }
    } catch (e) {
      console.warn("Could not load slot-analysis-report.json");
    }

    if (registryData && registryData.frames) {
      // Merge analysis reports and record original sequence index (1-based padded string, e.g. "01")
      state.frames = registryData.frames.map((frame, index) => {
        const report = analysisReport?.frames?.find(f => f.id === frame.id);
        return {
          ...frame,
          originalNum: String(index + 1).padStart(2, '0'),
          transparentPixels: report?.transparentPixels || 0,
          transparentPercent: report?.transparentPercent || 0
        };
      });

      // Sort alphabetically by default
      state.frames.sort((a, b) => a.name.localeCompare(b.name, 'vi'));

      // 1. Generate unique photo fittings for all 58 frames
      generatePreFittedPhotosStates();

      // 2. Preload all unique image assets (6 capture photos + 58 frame overlays)
      const loader3d = document.getElementById('gallery-loader');
      const loaderText = loader3d?.querySelector('p');
      const loaderSub = loader3d?.querySelector('.loader-sub');
      
      const imageUrls = Array.from(new Set([
        ...state.samplePhotos,
        ...state.frames.map(f => `./frames/${f.source}`),
        './bg_mansion.jpg'
      ]));

      let loadedCount = 0;
      const totalImages = imageUrls.length;

      const preloadImage = (url) => {
        return new Promise((resolve) => {
          const img = new Image();
          img.src = url;
          img.onload = () => {
            loadedCount++;
            state.loadedImages[url] = img; // Keep reference to preloaded Image element
            if (loaderText && loaderSub) {
              const percent = Math.round((loadedCount / totalImages) * 100);
              loaderText.textContent = `Đang tải tài nguyên: ${percent}%`;
              loaderSub.textContent = `Đang tải hình ảnh và khung (${loadedCount}/${totalImages})`;
            }
            resolve(url);
          };
          img.onerror = () => {
            loadedCount++;
            state.loadedImages[url] = img; // Fallback even if fail
            if (loaderText && loaderSub) {
              const percent = Math.round((loadedCount / totalImages) * 100);
              loaderText.textContent = `Đang tải tài nguyên: ${percent}%`;
              loaderSub.textContent = `Đang tải hình ảnh và khung (${loadedCount}/${totalImages})`;
            }
            console.error(`Failed to preload image: ${url}`);
            resolve(url);
          };
        });
      };

      await Promise.all(imageUrls.map(url => preloadImage(url)));

      // 3. Build the 3D WebGL theater
      build3DWebGLTheater();

      // Fade out loader
      if (loader3d) {
        loader3d.classList.add('hidden');
        setTimeout(() => loader3d.style.display = 'none', 500);
      }

      // Update totals
      const statsTotal = document.getElementById('stats-total-frames');
      if (statsTotal) statsTotal.textContent = state.frames.length;
      updateLanguageDOM();
    }
  } catch (error) {
    console.error('Error initializing 3D gallery:', error);
    const container = document.getElementById('gallery-3d-stage');
    if (container) {
      container.innerHTML = `
        <div class="loader-3d">
          <i class="fa-solid fa-triangle-exclamation" style="font-size: 2.5rem; color: var(--accent-neon-pink); margin-bottom: 1rem;"></i>
          <p>Lỗi tải phòng triển lãm tranh 3D. Vui lòng chạy lại server phát triển.</p>
          <code style="color: var(--text-muted); margin-top: 0.5rem;">${error.message}</code>
        </div>
      `;
    }
  }
}

// --- Generate Fit Transformations for Every Slot of All 58 Frames ---
function generatePreFittedPhotosStates() {
  const assignedSessionByFrameId = {};
  const usedSessions = new Set();
  
  // Phase 1: Assign direct matches
  state.frames.forEach(frame => {
    const frameNum = frame.originalNum;
    
    if (frameNum && sessionsByFrameNum[frameNum] && sessionsByFrameNum[frameNum].length > 0) {
      const matchedSession = sessionsByFrameNum[frameNum][0];
      assignedSessionByFrameId[frame.id] = matchedSession;
      usedSessions.add(matchedSession);
    }
  });
  
  // Phase 2: Collect unused sessions (including extra matches)
  const unusedSessions = customerSessions.filter(s => !usedSessions.has(s));
  
  // Phase 3: Assign sessions to frames that don't have direct matches
  state.frames.forEach((frame, frameIdx) => {
    if (!assignedSessionByFrameId[frame.id]) {
      if (unusedSessions.length > 0) {
        const session = unusedSessions.shift();
        assignedSessionByFrameId[frame.id] = session;
      } else {
        // Cycle through all sessions to distribute them across the remaining hallway
        const sessionIdx = (frameIdx * 3) % customerSessions.length;
        assignedSessionByFrameId[frame.id] = customerSessions[sessionIdx];
      }
    }
  });

  // Phase 4: Fit photos inside frame slots (strictly within the folder)
  state.frames.forEach((frame, frameIdx) => {
    const slotsFit = [];
    const session = assignedSessionByFrameId[frame.id];
    const photos = session ? session.photos : allCustomerPhotos;
    
    frame.slots.forEach((slot, slotIdx) => {
      // Pick photo from the assigned session only
      // Offset by frameIdx to avoid identical mapping on duplicate frames
      const photoSrcIdx = (slotIdx + frameIdx) % photos.length;
      const imgSrc = photos[photoSrcIdx];

      const imgWidth = 1920;
      const imgHeight = 1080;

      const nativeSlotWidth = slot.width;
      const nativeSlotHeight = slot.height;

      const scaleX = nativeSlotWidth / imgWidth;
      const scaleY = nativeSlotHeight / imgHeight;
      const coverScale = Math.max(scaleX, scaleY);

      // Fit photo perfectly to cover the slot with a 2% safety margin to ensure no sub-pixel rendering gaps
      const standardScale = coverScale * 1.02;

      slotsFit.push({
        imgSrc: imgSrc,
        x: 0,
        y: 0,
        scale: standardScale,
        minScale: coverScale,
        rotation: 0,
        flipX: false,
        flipY: false,
        filter: 'none'
      });
    });

    state.frameFittedStates[frame.id] = slotsFit;
  });
}

// --- Unified Canvas Generator for WebGL Texture, Detail Preview, and Export ---
function getFrameCanvas(frame, targetWidth, targetHeight) {
  const canvas = document.createElement('canvas');
  canvas.width = targetWidth;
  canvas.height = targetHeight;
  const ctx = canvas.getContext('2d');
  // Keep background transparent to support transparent PNG frame overlays

  const canvasFilters = {
    'none': 'none',
    'grayscale': 'grayscale(100%)',
    'sepia': 'sepia(100%)',
    'vintage': 'sepia(50%) contrast(120%) brightness(90%) hue-rotate(-15deg)',
    'warm': 'sepia(20%) saturate(140%) hue-rotate(5deg)',
    'cool': 'saturate(120%) hue-rotate(15deg) brightness(105%)',
    'vivid': 'saturate(180%) contrast(110%)',
    'lofi': 'contrast(130%) saturate(110%) brightness(95%)'
  };

  const fitStateList = state.frameFittedStates[frame.id];
  const scaleF = targetHeight / frame.height;

  // Draw photos inside slots
  frame.slots.forEach((slot, index) => {
    const photoState = fitStateList[index];
    if (!photoState) return;

    const img = state.loadedImages[photoState.imgSrc];
    if (!img) return;

    ctx.save();
    
    // Clip viewport
    ctx.beginPath();
    ctx.rect(slot.x * scaleF, slot.y * scaleF, slot.width * scaleF, slot.height * scaleF);
    ctx.clip();

    // Set filters presets
    if (photoState.filter && canvasFilters[photoState.filter]) {
      ctx.filter = canvasFilters[photoState.filter];
    }

    const slotCenterX = (slot.x + slot.width / 2) * scaleF;
    const slotCenterY = (slot.y + slot.height / 2) * scaleF;

    // Transform order: translate to center -> translate drag offsets -> rotate -> scale & flips
    ctx.translate(slotCenterX, slotCenterY);
    ctx.translate(photoState.x * scaleF, photoState.y * scaleF);
    ctx.rotate((photoState.rotation * Math.PI) / 180);
    ctx.scale(photoState.scale * scaleF * (photoState.flipX ? -1 : 1), photoState.scale * scaleF * (photoState.flipY ? -1 : 1));

    // Draw capture image centered (Native size 1920x1080)
    ctx.drawImage(img, -img.naturalWidth / 2, -img.naturalHeight / 2, img.naturalWidth, img.naturalHeight);
    
    ctx.restore();
  });

  // Draw overlay frame
  const overlayUrl = `./frames/${frame.source}`;
  const overlayImg = state.loadedImages[overlayUrl];
  if (overlayImg) {
    // Render the frame overlay with its original clean pixels (no filter)
    ctx.filter = 'none';
    ctx.drawImage(overlayImg, 0, 0, targetWidth, targetHeight);
  }

  return canvas;
}

// --- Dynamic Text Label Canvas Texture Generator for Frames ---
function createLabelTexture(text) {
  const canvas = document.createElement('canvas');
  canvas.width = 512;
  canvas.height = 96;
  const ctx = canvas.getContext('2d');

  ctx.clearRect(0, 0, canvas.width, canvas.height);

  const r = 24; // rounded corner radius
  const x = 16;
  const y = 16;
  const w = canvas.width - 32;
  const h = canvas.height - 32;

  ctx.save();
  
  // Create drop shadow for the text badge
  ctx.shadowColor = 'rgba(0, 0, 0, 0.5)';
  ctx.shadowBlur = 10;
  ctx.shadowOffsetY = 4;

  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.lineTo(x + w - r, y);
  ctx.quadraticCurveTo(x + w, y, x + w, y + r);
  ctx.lineTo(x + w, y + h - r);
  ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
  ctx.lineTo(x + r, y + h);
  ctx.quadraticCurveTo(x, y + h, x, y + h - r);
  ctx.lineTo(x, y + r);
  ctx.quadraticCurveTo(x, y, x + r, y);
  ctx.closePath();

  // Glassmorphic dark charcoal background
  ctx.fillStyle = 'rgba(20, 16, 13, 0.9)';
  ctx.fill();

  // Gold/Bronze border matching museum theme
  ctx.shadowColor = 'transparent';
  ctx.strokeStyle = 'rgba(212, 175, 55, 0.6)';
  ctx.lineWidth = 2.5;
  ctx.stroke();

  // Draw frame name text centered
  ctx.fillStyle = '#ffffff';
  ctx.font = 'bold 28px "Outfit", "Space Grotesk", sans-serif';
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  
  // Subtle text shadow
  ctx.shadowColor = 'rgba(0, 0, 0, 0.6)';
  ctx.shadowBlur = 4;
  ctx.shadowOffsetY = 2;

  ctx.fillText(text, canvas.width / 2, canvas.height / 2);
  ctx.restore();

  const texture = new THREE.CanvasTexture(canvas);
  texture.minFilter = THREE.LinearFilter;
  return texture;
}

