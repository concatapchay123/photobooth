// --- Sync Language strings in DOM ---
function updateLanguageDOM() {
  const dict = translations[state.lang];
  
  // HUD Header (Null-checked as header banner is removed)
  const subtitleEl = document.getElementById('hud-subtitle-text');
  if (subtitleEl) subtitleEl.textContent = dict.hudSubtitle;
  
  const statTotalEl = document.querySelector('.hud-stat-item:first-child .hud-stat-lbl');
  if (statTotalEl) statTotalEl.textContent = dict.statsTotalFrames;
  
  const statPosEl = document.querySelector('.hud-stat-item:last-child .hud-stat-lbl');
  if (statPosEl) statPosEl.textContent = dict.statsCorridorDepth;

  // HUD Control Panels
  document.querySelector('.mode-selector .control-title').innerHTML = `<i class="fa-solid fa-sliders"></i> ${dict.viewModeLabel}`;
  document.getElementById('mode-auto-btn').innerHTML = `<i class="fa-solid fa-circle-play"></i> ${dict.modeAuto}`;
  document.getElementById('mode-manual-btn').innerHTML = `<i class="fa-solid fa-hand-pointer"></i> ${dict.modeManual}`;
  
  document.querySelector('.nav-controls .control-title').innerHTML = `<i class="fa-solid fa-compass"></i> ${dict.navLabel}`;
  document.querySelector('.tour-settings .control-title').innerHTML = `<i class="fa-solid fa-gauge-high"></i> ${dict.speedLabel}`;
  
  // Tour text status
  const statusLabel = document.getElementById('tour-status-text');
  if (statusLabel) {
    if (state.viewMode === 'auto') {
      statusLabel.innerHTML = `<span class="pulse-dot"></span> ${dict.tourStatusAuto}`;
    } else {
      statusLabel.innerHTML = `<i class="fa-solid fa-circle-pause" style="color: var(--text-muted)"></i> ${dict.tourStatusManual}`;
    }
  }

  document.querySelector('.tour-progress .control-title').innerHTML = `<i class="fa-solid fa-route"></i> ${dict.progressLabel}`;
  const labels = document.querySelectorAll('.progress-labels span');
  if (labels.length >= 2) {
    labels[0].textContent = dict.progressStart;
    labels[1].textContent = dict.progressEnd;
  }

  // Help Onboarding modal
  const helpModal = document.getElementById('help-modal');
  helpModal.querySelector('.modal-header h3').innerHTML = `<i class="fa-solid fa-cube"></i> ${dict.modalHeading}`;
  helpModal.querySelector('.modal-intro').textContent = dict.modalIntro;
  document.getElementById('close-modal-ok').textContent = dict.modalCloseBtn;
  
  const steps = helpModal.querySelectorAll('.instruction-step');
  if (steps.length >= 3) {
    steps[0].querySelector('.step-text').innerHTML = dict.modalAutoStep;
    steps[1].querySelector('.step-text').innerHTML = dict.modalManualStep;
    steps[2].querySelector('.step-text').innerHTML = dict.modalFitStep;
  }

  // Update footer statistics dynamically
  const footerEl = document.querySelector('.hud-footer p');
  if (footerEl) {
    footerEl.innerHTML = state.lang === 'vi' 
      ? `&copy; 2026 Photobooth 3D Art Gallery. Dữ liệu: ${state.frames.length} Khung ảnh | Đã nạp ${allCustomerPhotos.length} ảnh khách hàng.`
      : `&copy; 2026 Photobooth 3D Art Gallery. Data: ${state.frames.length} Frames | ${allCustomerPhotos.length} customer photos loaded.`;
  }
}

