/* ==========================================================================
   3D PHOTOBOOTH FRAME EXHIBITION - CORE STYLESHEET
   Theme: Immersive Cyberpunk Museum Hallway (Glassmorphism & Neon Shadows)
   ========================================================================== */

/* --- Custom Variables (Design Tokens) --- */
:root {
  --bg-color: #0d0b09; /* Warm dark charcoal/brown */
  --bg-grid: rgba(212, 175, 55, 0.015);
  
  --panel-bg: rgba(15, 12, 10, 0.85); /* Warm dark panel background */
  --panel-border: rgba(255, 255, 255, 0.06);
  --panel-glow-purple: rgba(197, 160, 89, 0.2); /* Soft bronze glow */
  --panel-glow-pink: rgba(212, 175, 55, 0.2); /* Soft gold glow */
  
  --text-primary: #fbfaf9;
  --text-secondary: #cbd5e1;
  --text-muted: #847664; /* Warm muted text */
  
  --accent-neon-pink: #d4af37; /* Metallic Gold */
  --accent-neon-blue: #ffaa44;  /* Warm Amber */
  --accent-neon-purple: #c5a059; /* Soft Bronze/Gold */
  
  --gradient-neon: linear-gradient(135deg, var(--accent-neon-pink), var(--accent-neon-purple));
  --gradient-neon-blue: linear-gradient(135deg, var(--accent-neon-blue), var(--accent-neon-purple));
  --gradient-glass: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01));
  
  --font-main: 'Outfit', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  --font-header: 'Space Grotesk', sans-serif;
  
  --shadow-neon-pink: 0 0 20px rgba(212, 175, 55, 0.35), 0 0 40px rgba(212, 175, 55, 0.15);
  --shadow-neon-blue: 0 0 20px rgba(255, 170, 68, 0.35), 0 0 40px rgba(255, 170, 68, 0.15);
  --shadow-neon-purple: 0 0 20px rgba(197, 160, 89, 0.35), 0 0 40px rgba(197, 160, 89, 0.15);
  
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 24px;
  
  --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-normal: 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
  --transition-camera: transform 0.6s cubic-bezier(0.1, 0.76, 0.55, 0.94); /* Smooth camera glide */
}

/* --- Reset & Global Base --- */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: var(--font-main);
  background-color: var(--bg-color);
  background: #0d0b09 url('/bg_mansion.jpg') no-repeat center center/cover;
  color: var(--text-primary);
  min-height: 100vh;
  overflow: hidden; /* No scrollbars on body since we move in 3D */
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  user-select: none;
}

/* --- Animated Corner Glow Backgrounds --- */
.glow-bg-1 {
  position: fixed;
  top: -10%;
  left: -10%;
  width: 50%;
  height: 50%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, rgba(212, 175, 55, 0) 70%);
  filter: blur(80px);
  z-index: -2;
  pointer-events: none;
}

.glow-bg-2 {
  position: fixed;
  bottom: -10%;
  right: -10%;
  width: 50%;
  height: 50%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 170, 68, 0.12) 0%, rgba(255, 170, 68, 0) 70%);
  filter: blur(80px);
  z-index: -2;
  pointer-events: none;
}

/* --- Scrollbar Customization --- */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: rgba(0, 0, 0, 0.3);
}
::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 3px;
}
::-webkit-scrollbar-thumb:hover {
  background: var(--accent-neon-pink);
}

/* --- Typography Helpers --- */
h1, h2, h3, h4, h5, h6 {
  font-family: var(--font-header);
  font-weight: 700;
  letter-spacing: -0.01em;
}

/* --- Button base styles --- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.7rem 1.25rem;
  font-family: var(--font-main);
  font-weight: 600;
  font-size: 0.9rem;
  border-radius: var(--radius-sm);
  border: none;
  cursor: pointer;
  white-space: nowrap;
  transition: all var(--transition-fast);
  outline: none;
}

.w-full {
  width: 100%;
}

.btn-primary-neon {
  background: var(--gradient-neon);
  color: #fff;
  box-shadow: 0 4px 15px rgba(255, 42, 133, 0.3);
}
.btn-primary-neon:hover {
  filter: brightness(1.15);
  box-shadow: 0 0 25px rgba(255, 42, 133, 0.5);
  transform: translateY(-2px);
}
.btn-primary-neon:active {
  transform: translateY(0);
}

.btn-glass {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--text-primary);
}
.btn-glass:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.15);
  transform: translateY(-2px);
}

.btn-hud {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(255, 255, 255, 0.05);
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all var(--transition-fast);
}
.btn-hud:hover {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--accent-neon-blue);
  color: var(--accent-neon-blue);
  transform: translateY(-1px);
}

.glass-panel {
  background: rgba(10, 14, 26, 0.92); /* Robust fallback for headless/compatibility */
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid var(--panel-border);
  box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.05);
}

/* ==========================================================================
   HEADER HUD (HEADS-UP DISPLAY)
   ========================================================================== */
.hud-header {
  position: fixed;
  top: 1.5rem;
  left: 0;
  right: 0;
  margin: 0 auto;
  width: 90%;
  max-width: 1300px;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.8rem 2rem;
  border-radius: var(--radius-md);
  pointer-events: auto; /* Catch clicks */
}

.hud-logo-area {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.hud-logo-icon {
  width: 38px;
  height: 38px;
  border-radius: 8px;
  background: var(--gradient-neon);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 12px rgba(139, 92, 246, 0.3);
  color: #fff;
  font-size: 1.1rem;
}

.hud-title {
  font-size: 1.25rem;
  font-weight: 800;
  letter-spacing: 0.04em;
  color: #fff;
}
.hud-title span {
  color: var(--accent-neon-blue);
  text-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
}

.hud-subtitle {
  font-size: 0.75rem;
  color: var(--text-secondary);
}

.hud-stats-area {
  display: flex;
  align-items: center;
  gap: 2rem;
}

.hud-stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hud-stat-val {
  font-family: var(--font-header);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--accent-neon-blue);
  line-height: 1;
}

.hud-stat-lbl {
  font-size: 0.7rem;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-top: 0.2rem;
}

.hud-header-controls {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.lang-txt {
  font-weight: 800;
  font-size: 0.75rem;
}

/* ==========================================================================
   3D VIEWPORT STAGE AND TUNNEL
   ========================================================================== */
.gallery-3d-stage {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  background-color: #03050a;
  z-index: 1;
}

.gallery-3d-stage canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  display: block;
}


.loader-3d {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-secondary);
  text-align: center;
  z-index: 10;
  transition: opacity 0.5s ease;
}

.loader-3d.hidden {
  opacity: 0;
  pointer-events: none;
}

.loader-sub {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-top: 0.5rem;
}



/* ==========================================================================
   LENS OVERLAYS / SCREEN EFFECTS
   ========================================================================== */
.camera-lens-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  box-shadow: inset 0 0 150px rgba(0, 0, 0, 0.12);
  pointer-events: none;
  z-index: 5; /* Above Z viewport but below HUD */
}

/* Crosshair indicator in the center of the camera */
.crosshair-indicator {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20px;
  height: 20px;
  pointer-events: none;
  z-index: 4;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.crosshair-indicator::before,
.crosshair-indicator::after {
  content: '';
  position: absolute;
  background: rgba(0, 240, 255, 0.3);
}
.crosshair-indicator::before {
  top: 9px;
  left: 0;
  width: 20px;
  height: 2px;
}
.crosshair-indicator::after {
  top: 0;
  left: 9px;
  width: 2px;
  height: 20px;
}

.gallery-3d-stage.manual-explore-mode {
  cursor: grab;
}
.gallery-3d-stage.manual-explore-mode:active {
  cursor: grabbing;
}
.gallery-3d-stage.manual-explore-mode .crosshair-indicator {
  opacity: 0.5;
}

/* ==========================================================================
   FLOATING HUD CONTROL PANEL (BOTTOM)
   ========================================================================== */
.hud-control-panel {
  position: fixed;
  bottom: 2rem;
  left: 0;
  right: 0;
  margin: 0 auto;
  width: 90%;
  max-width: 1100px;
  height: 100px;
  z-index: 100;
  border-radius: var(--radius-md);
  display: none; /* Hidden per user request */
  align-items: center;
  justify-content: space-between;
  padding: 1rem 2rem;
  pointer-events: auto;
  gap: 1.5rem;
}

.control-section {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  flex: 1;
}

.control-title {
  font-size: 0.75rem;
  color: var(--text-muted);
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 0.05em;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}

.control-title i {
  color: var(--accent-neon-blue);
}

/* Mode toggles */
.mode-selector {
  max-width: 180px;
}

.toggle-switch-group {
  display: flex;
  background: rgba(0, 0, 0, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 8px;
  padding: 2px;
}

.toggle-btn {
  flex: 1;
  background: transparent;
  border: none;
  border-radius: 6px;
  color: var(--text-secondary);
  font-family: var(--font-main);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 0.5rem 0.6rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  transition: all var(--transition-fast);
}

.toggle-btn:hover {
  color: #fff;
}

.toggle-btn.active {
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
  color: var(--accent-neon-blue);
  box-shadow: 0 0 8px rgba(0, 240, 255, 0.15);
}

/* Navigation D-Pad */
.nav-controls {
  max-width: 200px;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: opacity 0.3s ease;
}

.nav-controls.disabled {
  opacity: 0.25;
  pointer-events: none;
}

.nav-dpad {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
}

.nav-row {
  display: flex;
  gap: 2px;
}

.nav-btn {
  width: 26px;
  height: 22px;
  border-radius: 4px;
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.05);
  color: var(--text-secondary);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.7rem;
  transition: all var(--transition-fast);
}

.nav-btn:hover {
  background: rgba(0, 240, 255, 0.1);
  border-color: var(--accent-neon-blue);
  color: #fff;
}

#nav-reset {
  width: 32px;
  background: rgba(139, 92, 246, 0.08);
  border-color: rgba(139, 92, 246, 0.15);
  color: var(--accent-neon-purple);
}
#nav-reset:hover {
  background: rgba(139, 92, 246, 0.18);
  color: #fff;
}

/* Speed adjustment */
.tour-settings {
  max-width: 220px;
}

.speed-slider-wrap {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.speed-slider-wrap input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  flex: 1;
  height: 4px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 2px;
  outline: none;
}

.speed-slider-wrap input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: var(--accent-neon-blue);
  cursor: pointer;
  box-shadow: 0 0 6px var(--accent-neon-blue);
}

.speed-value {
  font-family: monospace;
  font-size: 0.8rem;
  font-weight: 700;
  color: var(--accent-neon-blue);
}

.tour-status-text {
  font-size: 0.7rem;
  color: var(--text-secondary);
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin-top: 0.25rem;
}

.pulse-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background-color: var(--accent-neon-pink);
  animation: pulse-glow 1.5s infinite ease-in-out;
}

@keyframes pulse-glow {
  0%, 100% { transform: scale(1); opacity: 0.5; box-shadow: 0 0 0 0 rgba(255, 42, 133, 0); }
  50% { transform: scale(1.3); opacity: 1; box-shadow: 0 0 8px 2px rgba(255, 42, 133, 0.4); }
}

/* Progress bar */
.tour-progress {
  max-width: 320px;
}

.progress-bar-container {
  height: 6px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
  overflow: hidden;
  position: relative;
  cursor: pointer;
}

.progress-bar-fill {
  height: 100%;
  background: var(--gradient-neon-blue);
  box-shadow: 0 0 8px rgba(0, 240, 255, 0.4);
  border-radius: 3px;
  transition: width 0.3s ease-out;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  font-size: 0.65rem;
  color: var(--text-muted);
  margin-top: 0.25rem;
}

/* ==========================================================================
   SLIDE-OUT DETAIL PANEL (RIGHT SIDE CARD)
   ========================================================================== */
/* Sidebar details card styles removed completely per user request */

/* ==========================================================================
   MODALS AND INSTRUCTIONS
   ========================================================================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(5, 7, 12, 0.8);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  z-index: 1000;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.modal-overlay.active {
  display: flex;
}

.modal-content {
  width: 100%;
  max-width: 640px;
  background: var(--panel-bg);
  border: 1px solid var(--panel-border);
  box-shadow: 0 20px 50px rgba(0,0,0,0.8), 0 0 30px rgba(139, 92, 246, 0.15);
  border-radius: var(--radius-md);
  overflow: hidden;
  pointer-events: auto;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--panel-border);
  background: rgba(10, 14, 26, 0.4);
}

.modal-header h3 {
  font-size: 1.2rem;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.modal-header h3 i {
  color: var(--accent-neon-blue);
}

.modal-close {
  background: transparent;
  border: none;
  color: var(--text-secondary);
  font-size: 1.6rem;
  line-height: 1;
  cursor: pointer;
  transition: color var(--transition-fast);
}
.modal-close:hover {
  color: var(--accent-neon-pink);
}

.modal-body {
  padding: 1.75rem;
  max-height: calc(85vh - 120px);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.modal-intro {
  font-size: 0.95rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

.instruction-step {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
}

.step-num {
  width: 48px;
  height: 28px;
  border-radius: 14px;
  background: var(--gradient-neon);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.75rem;
  flex-shrink: 0;
  box-shadow: 0 0 10px rgba(255, 42, 133, 0.3);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.step-text {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.5;
}
.step-text strong {
  color: #fff;
}
.step-text ul {
  margin-top: 0.5rem;
  margin-left: 1.2rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.step-text li {
  list-style-type: circle;
  font-size: 0.85rem;
}

.modal-footer {
  padding: 1rem 1.75rem;
  border-top: 1px solid var(--panel-border);
  background: rgba(10, 14, 26, 0.2);
  display: flex;
  justify-content: flex-end;
}

/* --- Animations --- */
.animated {
  animation-duration: 0.35s;
  animation-fill-mode: both;
}

@keyframes zoomIn {
  from {
    opacity: 0;
    transform: scale3d(0.93, 0.93, 0.93);
  }
  to {
    opacity: 1;
  }
}
.zoomIn {
  animation-name: zoomIn;
}

/* ==========================================================================
   HUD FOOTER & TOAST
   ========================================================================== */
.hud-footer {
  position: fixed;
  bottom: 0.5rem;
  left: 50%;
  transform: translateX(-50%);
  color: var(--text-muted);
  font-size: 0.65rem;
  pointer-events: none;
  z-index: 10;
}

/* Presets filter classes for canvas resolution export */
.f-grayscale { filter: grayscale(1); }
.f-sepia { filter: sepia(1); }
.f-vintage { filter: sepia(0.5) contrast(1.2) brightness(0.9) hue-rotate(-15deg); }
.f-warm { filter: sepia(0.2) saturate(1.4) hue-rotate(5deg); }
.f-cool { filter: saturate(1.2) hue-rotate(15deg) brightness(1.05); }
.f-vivid { filter: saturate(1.8) contrast(1.1); }
.f-lofi { filter: contrast(1.3) saturate(1.1) brightness(0.95); }
.f-none { filter: none; }

/* Floating Top Center Frame Title HUD Badge */
.focused-frame-hud {
  position: fixed;
  top: 1.5rem;
  left: 50%;
  transform: translateX(-50%) translateY(-100px);
  z-index: 100;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 2rem;
  border-radius: var(--radius-md);
  border: 1px solid rgba(212, 175, 55, 0.35);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6), 0 0 15px rgba(212, 175, 55, 0.15);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1), opacity 0.6s ease;
}

.focused-frame-hud i {
  color: var(--accent-neon-blue);
  font-size: 1.25rem;
}

.focused-frame-hud span {
  font-family: var(--font-header);
  font-weight: 700;
  letter-spacing: 0.05em;
  font-size: 1.1rem;
  color: #fff;
  text-shadow: 0 0 8px rgba(255, 255, 255, 0.2);
}

